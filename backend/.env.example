# Copy to backend/.env for local development.
# In production (Render), set these as environment variables on the service instead.

ENVIRONMENT=dev

# CORS: comma-separated list of allowed frontend origins (no trailing slash).
# e.g. FRONTEND_ORIGIN=https://quizly.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# Optional regex for extra allowed origins, e.g. Vercel preview deployments:
# FRONTEND_ORIGIN_REGEX=https://quizly-.*\.vercel\.app
FRONTEND_ORIGIN_REGEX=

# SQLite by default. Use a Postgres URL (postgres://... or postgresql://...) for persistent storage.
DATABASE_URL=sqlite:///./quizly.db

# LLM: no server-side keys. Users enter their own Groq (default) or OpenRouter
# API key in the app; it is sent per request and never stored.
# Both providers use openai/gpt-oss-120b.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
